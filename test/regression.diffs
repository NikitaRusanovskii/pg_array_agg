+-- ============================================================
+-- A. Неподдерживаемые типы
+-- ============================================================
+SELECT array_count_if(ARRAY[true, false], 'x == 1');
+ERROR:  array_count_if: incorrect datatype
+SELECT array_all(ARRAY[true, false], 'x == 1');
+ERROR:  array_all: incorrect datatype
+SELECT array_any(ARRAY[true, false], 'x == 1');
+ERROR:  array_any: incorrect datatype
+SELECT array_none(ARRAY[true, false], 'x == 1');
+ERROR:  array_none: incorrect datatype
+-- Массивы неподдерживаемых составных типов, если они не реализованы
+SELECT array_count_if(ARRAY[DATE '2026-01-01'], 'x == 1');
+ERROR:  array_count_if: incorrect datatype
+-- ============================================================
+-- B. Многомерные массивы
+-- ============================================================
+SELECT array_count_if(ARRAY[[1, 2], [3, 4]], 'x == 1');
+ERROR:  array_count_if: searching elements in manydimensional arrays is not supported yet
+SELECT array_all(ARRAY[[1, 2], [3, 4]], 'x == 1');
+ERROR:  array_all: searching elements in manydimensional arrays is not supported yet
+SELECT array_any(ARRAY[[1, 2], [3, 4]], 'x == 1');
+ERROR:  array_any: searching elements in manydimensional arrays is not supported yet
+SELECT array_none(ARRAY[[1, 2], [3, 4]], 'x == 1');
+ERROR:  array_none: searching elements in manydimensional arrays is not supported yet
+-- ============================================================
+-- C. Некорректный синтаксис
+-- ============================================================
+SELECT array_count_if(ARRAY[1, 2], '');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 1
+SELECT array_count_if(ARRAY[1, 2], 'x');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 2
+SELECT array_count_if(ARRAY[1, 2], 'x ==');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 3
+SELECT array_count_if(ARRAY[1, 2], '== 1');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 3
+SELECT array_count_if(ARRAY[1, 2], 'x @@@ 1');
+ERROR:  syntaxical_analize: Invalid first operator: 1
+SELECT array_count_if(ARRAY[1, 2], 'x == 1 extra');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 5
+SELECT array_count_if(ARRAY[1, 2], 'x === 1');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 5
+SELECT array_count_if(ARRAY[1, 2], 'x !=');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 3
+-- Некорректный синтаксис modulo
+SELECT array_count_if(ARRAY[1, 2], 'x %');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 3
+SELECT array_count_if(ARRAY[1, 2], 'x % 2');
+ERROR:  syntaxical_analize: Invalid first operator: 9
+SELECT array_count_if(ARRAY[1, 2], 'x % 2 =');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 5
+SELECT array_count_if(ARRAY[1, 2], 'x % 2 == 0');
+ERROR:  syntaxical_analize: Invalid second operator: 3
+SELECT array_count_if(ARRAY[1, 2], 'x % 2 = 0 extra');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 7
+-- ============================================================
+-- D. Ошибки преобразования константы
+-- ============================================================
+SELECT array_count_if(ARRAY[1, 2], 'x == "abc"');
+ERROR:  invalid input syntax for type integer: "abc"
+SELECT array_count_if(ARRAY[1, 2], 'x == ''not_a_number''');
+ERROR:  invalid input syntax for type integer: "not_a_number"
+SELECT array_count_if(ARRAY[1, 2], 'x == 999999999999999999999999999999999999');
+ERROR:  value "999999999999999999999999999999999999" is out of range for type integer
+-- ============================================================
+-- E. Недопустимые операторы для типов
+-- ============================================================
+SELECT array_count_if(ARRAY['a', 'b']::text[], 'x > "a"');
+ERROR:  cast_predicate: Invalid operator. Type: TEXT, operator: 2
+SELECT array_count_if(ARRAY['a', 'b']::text[], 'x < "b"');
+ERROR:  cast_predicate: Invalid operator. Type: TEXT, operator: 3
+SELECT array_count_if(ARRAY['a', 'b']::text[], 'x >= "a"');
+ERROR:  cast_predicate: Invalid operator. Type: TEXT, operator: 4
+SELECT array_count_if(ARRAY['a', 'b']::text[], 'x <= "b"');
+ERROR:  cast_predicate: Invalid operator. Type: TEXT, operator: 5
+SELECT array_count_if(ARRAY['a', 'b']::text[], 'x % 2 = 0');
+ERROR:  cast_predicate: Invalid operator. Type: TEXT, operator: 6
+-- ============================================================
+-- F. Деление по модулю на ноль
+-- ============================================================
+SELECT array_count_if(ARRAY[1, 2, 3], 'x % 0 = 0');
+ERROR:  process: division by zero
+SELECT array_all(ARRAY[1, 2, 3], 'x % 0 = 0');
+ERROR:  process: division by zero
+SELECT array_any(ARRAY[1, 2, 3], 'x % 0 = 0');
+ERROR:  process: division by zero
+SELECT array_none(ARRAY[1, 2, 3], 'x % 0 = 0');
+ERROR:  process: division by zero
+-- ============================================================
+-- G. Неверные типы констант
+-- ============================================================
+SELECT array_count_if(ARRAY[1, 2], 'x == "1"');
+ array_count_if 
+----------------
+              1
+(1 row)
+
+SELECT array_count_if(ARRAY[1.5, 2.5]::numeric[], 'x == "abc"');
+ERROR:  invalid input syntax for type numeric: "abc"
+-- ============================================================
+-- H. Другие формы некорректных выражений
+-- ============================================================
+SELECT array_count_if(ARRAY[1, 2], 'y == 1');
+ERROR:  syntaxical_analize: Invalid token array. First token is not variable
+SELECT array_count_if(ARRAY[1, 2], 'x + 1 == 2');
+ERROR:  syntaxical_analize: Invalid token array len: 6
+SELECT array_count_if(ARRAY[1, 2], 'x == 1 = 1');
+ERROR:  syntaxical_analize: Invalid token array len: 6
+SELECT array_count_if(ARRAY[1, 2], 'x % 2 = 0 = 1');
+ERROR:  syntaxical_analize: Invalid token array format. Array len: 8
+-- INT_MIN % -1: ожидается определённая ошибка,
+-- если такой случай запрещён реализацией.
+SELECT array_count_if(
+    ARRAY[-2147483648]::integer[],
+    'x % -1 = 0'
+);
+ERROR:  floating-point exception
+DETAIL:  An invalid floating-point operation was signaled. This probably means an out-of-range result or an invalid operation, such as division by zero.
+-- Проверки modulo для разных целочисленных типов
+SELECT array_count_if(ARRAY[-5, -4, -3, 0, 3, 4, 5], 'x % 2 = 0');
+ array_count_if 
+----------------
+              3
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3, 4], 'x % 3 = 1');
+ array_count_if 
+----------------
+              2
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3, 4], 'x % 3 = 0');
+ array_count_if 
+----------------
+              1
+(1 row)
+
+SELECT array_count_if(
+    ARRAY[-5, -4, -3, 0, 3, 4, 5]::bigint[],
+    'x % 2 = 0'
+);
+ array_count_if 
+----------------
+              3
+(1 row)
+
+SELECT array_count_if(
+    ARRAY[1.5, 2.0, 2.5, 3.0]::numeric[],
+    'x % 1 = 0'
+);
+ array_count_if 
+----------------
+              2
+(1 row)
+
+-- Число подходящих элементов равно array_count_if.
+SELECT
+    array_count_if(ARRAY[1, 2, 3, 4], 'x > 2') AS cnt,
+    array_all(ARRAY[1, 2, 3, 4], 'x > 2') AS all_result,
+    array_any(ARRAY[1, 2, 3, 4], 'x > 2') AS any_result,
+    array_none(ARRAY[1, 2, 3, 4], 'x > 2') AS none_result;
+ cnt | all_result | any_result | none_result 
+-----+------------+------------+-------------
+   2 | f          | t          | f
+(1 row)
+
+-- Все подходят: count = cardinality, all = true, any = true, none = false.
+SELECT
+    array_count_if(ARRAY[2, 2, 2], 'x == 2') AS cnt,
+    array_all(ARRAY[2, 2, 2], 'x == 2') AS all_result,
+    array_any(ARRAY[2, 2, 2], 'x == 2') AS any_result,
+    array_none(ARRAY[2, 2, 2], 'x == 2') AS none_result;
+ cnt | all_result | any_result | none_result 
+-----+------------+------------+-------------
+   3 | t          | t          | f
+(1 row)
+
+-- Ни один не подходит: count = 0, all = false, any = false, none = true.
+SELECT
+    array_count_if(ARRAY[1, 2, 3], 'x == 9') AS cnt,
+    array_all(ARRAY[1, 2, 3], 'x == 9') AS all_result,
+    array_any(ARRAY[1, 2, 3], 'x == 9') AS any_result,
+    array_none(ARRAY[1, 2, 3], 'x == 9') AS none_result;
+ cnt | all_result | any_result | none_result 
+-----+------------+------------+-------------
+   0 | f          | f          | t
+(1 row)
+
+SELECT array_count_if(
+    ARRAY(SELECT generate_series(1, 65000000)),
+    'x % 2 = 0'
+);
+ array_count_if 
+----------------
+       32500000
+(1 row)
+
+-- Ожидается: 34000000
+DROP EXTENSION IF EXISTS pg_array_agg;
