+-- ============================================================
+-- A. array_count_if: количество совпадений
+-- ============================================================
+-- Пустое количество совпадений
+SELECT array_count_if(ARRAY[1, 2, 3], 'x == 100'); -- 0
+ array_count_if 
+----------------
+              0
+(1 row)
+
+-- Все элементы совпадают
+SELECT array_count_if(ARRAY[1, 1, 1], 'x == 1'); -- 3
+ array_count_if 
+----------------
+              3
+(1 row)
+
+-- Ни одного совпадения
+SELECT array_count_if(ARRAY[1, 2, 3], 'x == 4'); -- 0
+ array_count_if 
+----------------
+              0
+(1 row)
+
+-- Одно совпадение
+SELECT array_count_if(ARRAY[1, 2, 3], 'x == 2'); -- 1
+ array_count_if 
+----------------
+              1
+(1 row)
+
+-- Несколько совпадений
+SELECT array_count_if(ARRAY[1, 2, 1, 3, 1], 'x == 1'); -- 3
+ array_count_if 
+----------------
+              3
+(1 row)
+
+-- Сравнения
+SELECT array_count_if(ARRAY[1, 2, 3, 4], 'x > 2');  -- 2
+ array_count_if 
+----------------
+              2
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3, 4], 'x < 3');  -- 2
+ array_count_if 
+----------------
+              2
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3, 4], 'x >= 3'); -- 2
+ array_count_if 
+----------------
+              2
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3, 4], 'x <= 2'); -- 2
+ array_count_if 
+----------------
+              2
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3, 4], 'x != 3'); -- 3
+ array_count_if 
+----------------
+              3
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3, 4], 'x == 3'); -- 1
+ array_count_if 
+----------------
+              1
+(1 row)
+
+-- Границы диапазона
+SELECT array_count_if(ARRAY[1, 2, 3], 'x > 0'); -- 3
+ array_count_if 
+----------------
+              3
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3], 'x < 4'); -- 3
+ array_count_if 
+----------------
+              3
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3], 'x >= 3'); -- 1
+ array_count_if 
+----------------
+              1
+(1 row)
+
+SELECT array_count_if(ARRAY[1, 2, 3], 'x <= 1'); -- 1
+ array_count_if 
+----------------
+              1
+(1 row)
+
+-- Повторяющиеся элементы
+SELECT array_count_if(ARRAY[5, 5, 5, 5], 'x == 5'); -- 4
+ array_count_if 
+----------------
+              4
+(1 row)
+
+SELECT array_count_if(ARRAY[5, 5, 5, 5], 'x != 5'); -- 0
+ array_count_if 
+----------------
+              0
+(1 row)
+
