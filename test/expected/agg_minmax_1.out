-----------
 -Infinity
(1 row)

SELECT array_min('{NaN, Infinity}'::real[]);
 array_min 
-----------
  Infinity
(1 row)

SELECT array_min(ARRAY[[1, 2], [3, 4]]);
 array_min 
-----------
         1
(1 row)

-- ДОЛЖНЫ ВЕРНУТЬ NULL
